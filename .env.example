# Optional. You do not need this file.
#
# The Chesspacito Firebase config is committed in src/net/config.ts, which is
# safe — a web config is not a secret, it ships to every browser anyway, and the
# database is protected by database.rules.json.
#
# Copy to .env.local only to point this app at a DIFFERENT Firebase project.
# Any variable set here overrides the matching field in src/net/config.ts.
# Restart the dev server afterwards; Vite reads env files at startup.

VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
