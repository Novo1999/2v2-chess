{
  "name": "consultation-chess",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "rules:build": "node rules/build.mjs",
    "test:rules": "node rules/build.mjs && firebase emulators:exec --only database --project demo-consultation-chess \"vitest run --config vitest.rules.config.ts\"",
    "test:all": "npm run test && npm run test:rules",
    "emulator": "firebase emulators:start --only database,auth --project demo-consultation-chess",
    "dev:local": "vite --mode emulator",
    "emulator:stop": "node scripts/free-port.mjs 9000 9099",
    "pretest:rules": "node scripts/free-port.mjs 9000 9099",
    "preemulator": "node scripts/free-port.mjs 9000 9099",
    "deploy": "npm run build && firebase deploy --only database,hosting",
    "deploy:rules": "node rules/build.mjs && firebase deploy --only database",
    "pieces:wood": "node scripts/build-wood-pieces.mjs",
    "board:grain": "node scripts/build-board-grain.mjs"
  },
  "dependencies": {
    "chess.js": "^1.0.0",
    "firebase": "^12.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "firebase-tools": "^13.35.1",
    "jsdom": "^28.1.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vitest": "^3.2.7"
  }
}
